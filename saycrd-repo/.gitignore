.vercel
.env*

# Generated per-deployment by build/env-config.js from environment variables.
# Environment-specific by design, so it must never be committed — a committed
# copy would pin every environment to whichever project built it last.
public/env-config.js

# Content-hashed copies of the static assets and the manifest that maps logical
# names to them, both generated by build/hash-assets.js on every build (including
# Vercel's). Never committed: the filenames change with the bytes, so a committed
# copy would go stale immediately and accumulate one dead file per edit. The
# committed index.html therefore keeps plain logical names and the build rewrites
# them -- run `git checkout public/index.html` after a local build.
public/static/
public/asset-manifest.json

# Scratch state written by the Supabase CLI (version checks, link/project refs).
# Machine-local, and project-ref files here can leak which database a developer
# last pointed the CLI at.
supabase/.temp/
